{
  "name": "serveprogen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official website of ServeProGen, an AI & software engineering studio.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --outDir build/client",

# Build-time settings. Copy to `.env.production.local` (git-ignored) to set them
# for `npm run build`. Never put secrets in VITE_ variables: they are embedded in
# the public JavaScript bundle. SMTP credentials go in server/private/mail-config.php
# on the server only.

# Canonical site URL, without a trailing slash. Leave empty until the domain is
# purchased. Enables canonical URLs, absolute Open Graph images and sitemap.xml.
VITE_SITE_URL=

# "false" ONLY for the real production site on the final domain. Any other value
# (or empty) adds noindex to every page and makes robots.txt block crawlers.
VITE_NOINDEX=true

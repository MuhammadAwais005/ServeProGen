# Public build-time settings (safe to commit in this example file only).
# Copy to .env.local for local overrides. Never put secrets in VITE_ variables:
# they are embedded in the public JavaScript bundle.

# Canonical site URL. Leave empty until the production domain is purchased.
VITE_SITE_URL=

# "true" adds noindex to every page (local and staging). Set to "false" only for production.
VITE_NOINDEX=true
